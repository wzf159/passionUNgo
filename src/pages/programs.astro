---
import Hero from "@/components/Hero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { media, programs } from "@/data/site";
---

<BaseLayout title="Programs" headerMode="tinted">
  <Hero
    title="Our Programs"
    variant="programs"
    image={media.programsPoster}
  >
    <div class="hero-copy">
      <p>Our programs empower people at every stage of life&mdash;from curious children and aspiring changemakers to families and local communities. Through hands-on learning, interdisciplinary research, and community collaboration, we make scientific knowledge understandable, accessible, and actionable for everyone.</p>
      <p>Whether inspiring the next generation through SENSE Kids, supporting future leaders through SENSE Changemakers, or strengthening neighborhoods through SENSE Community, our programs create opportunities for learning, innovation, and lasting social impact.</p>
    </div>
  </Hero>

  <section class="section section--mist">
    <div class="cards-grid cards-grid--programs">
      {programs.map((program) => (
        <article class="program-card">
          <img src={program.image} alt="" />
          <div class="card-body">
            <h3>{program.title}</h3>
            <p>{program.text}</p>
            <a class="button" href={program.link}>Read More</a>
          </div>
        </article>
      ))}
    </div>  

    <!-- <div class="partner-strip">
      <SectionHeading title="Program Partnerships" align="center" />
      <img src={media.partnerLogo} alt="Program partner logo" />
    </div> -->
  </section>
</BaseLayout>
