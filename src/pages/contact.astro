---
import Hero from "@/components/Hero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { contactCards, media } from "@/data/site";
---

<BaseLayout title="Contact" headerMode="overlay">
  <Hero
    title="Contact Us"
    subtitle="We'd love to hear from you. Whether you're interested in collaboration, have questions about our work, or simply want to connect, feel free to reach out."
    video={media.labsVideo}
    poster={media.labsPoster}
    variant="insights"
  />

  <section class="section section--paper contact-cards-section">
    <div class="contact-grid">
      {contactCards.map((card) => (
        <article class="contact-card" id={card.title.includes("Support") ? "support" : undefined}>
          <img src={card.image} alt="" />
          <div class="card-body">
            <h3>{card.title}</h3>
            <p>{card.text}</p>
            <a href={`mailto:${card.email}`}>{card.email}</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
