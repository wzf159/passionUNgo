---
import Hero from "@/components/Hero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { media } from "@/data/site";
---

<BaseLayout title="Contact" headerMode="overlay">
  <Hero
    title="Contact Us"
    subtitle="We&rsquo;d love to hear from you. Whether you&rsquo;re interested in collaboration, have questions about our work, or simply want to connect, feel free to reach out."
    image={media.contactPoster}
    variant="insights"
  />

  <section class="section contact-info-section">
    <article class="contact-info-card">
      <div class="contact-info-column">
        <h2>Let's Connect</h2>
        <p>For partnerships, collaborations, contributions, or general inquiries.</p>
        <a href="mailto:info@sense-institute.org"><strong>info@sense-institute.org</strong></a>
      </div>

      <div class="contact-info-divider" aria-hidden="true"></div>

      <div class="contact-info-column">
        <h2>Legal Information</h2>
        <p><strong>EIN:</strong> 41-5000983</p>
        <p><strong>Tax Status:</strong> 501(c)(3) Public Charity</p>
        <p><strong>Address:</strong> 711 Bolton Walk, Goleta, CA</p>
      </div>
    </article>
  </section>
</BaseLayout>
