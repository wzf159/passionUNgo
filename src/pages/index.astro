---
import Hero from "@/components/Hero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { media } from "@/data/site";
---

<BaseLayout title="Home" headerMode="overlay">
  <Hero
    title="SENSE Institute"
    subtitle="Turning knowledge into action for a better society."
    video={media.homeVideo}
    poster={media.homePoster}
    variant="home"
    ctaLabel="Support Our Mission"
    ctaHref="/contact/"
  />

  <section class="section section--mist home-news">
    <SectionHeading
      title="News"
      text="Latest updates, collaborations, research initiatives, and public programs from the SENSE community."
      align="center"
    />

    <article class="news-card">
      <img src={media.news} alt="Researchers working together in a meeting room" />
      <div>
        <h3>Partnering with PassionULab for Resilient Urban Futures</h3>
        <p>We are excited to announce our collaboration with PassionULab, an interdisciplinary team dedicated to data-driven environmental and urban innovation.</p>
        <p>Together, we are developing accessible web-based tools that help urban practitioners better understand climate risks, evaluate mitigation strategies, and support more informed decision-making for resilient communities.</p>
        <p>This partnership reflects our shared commitment to leveraging technology, data, and collaborative innovation to advance public well-being and build more resilient urban futures.</p>
      </div>
    </article>
  </section>

  <section class="section section--mist home-partners">
    <SectionHeading title="Our Partners" align="center" />
    <div class="home-partner-logo">
      <img src={media.partnerLogo} alt="Partner logo" />
      <img src={media.partnerLogo2} alt="Partner logo" />
    </div>
  </section>

  <section class="section section--ink">
    <div class="section-heading">
      <h2>How You Can Help</h2>
      <p>SENSE Institute is a registered 501(c)(3) nonprofit research organization led by an international network of young scholars, researchers, and practitioners. We advance problem-driven innovation for public impact through evidence-based research, public engagement programs, and open-source technology development.</p>
      <p>Your support helps turn research into real-world impact. You can contribute by donating, collaborating, or supporting our work.</p>
      <div class="support-actions">
        <a class="button button--mint support-btn" href="/contact/">
          <span>Donate</span>
          <svg class="btn-arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <line class="arrow-stem" x1="3" y1="17" x2="17" y2="3" stroke="currentColor" stroke-linecap="round" pathLength="100"/>
            <polyline class="arrow-head" points="9,3 17,3 17,11" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" pathLength="100"/>
          </svg>
        </a>
        <a class="button button--mint support-btn" href="/contact/">
          <span>Collaboration</span>
          <svg class="btn-arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <line class="arrow-stem" x1="3" y1="17" x2="17" y2="3" stroke="currentColor" stroke-linecap="round" pathLength="100"/>
            <polyline class="arrow-head" points="9,3 17,3 17,11" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" pathLength="100"/>
          </svg>
        </a>
        <a class="button button--mint support-btn" href="/contact/">
          <span>Join Us</span>
          <svg class="btn-arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <line class="arrow-stem" x1="3" y1="17" x2="17" y2="3" stroke="currentColor" stroke-linecap="round" pathLength="100"/>
            <polyline class="arrow-head" points="9,3 17,3 17,11" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" pathLength="100"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
