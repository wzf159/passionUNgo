---
import Hero from "@/components/Hero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { media } from "@/data/site";

const labs = [
  {
    title: "Social & Environmental Data Science Lab",
    bullets: [
      "Urban mobility and accessibility",
      "Spatial data analysis",
      "Built environment and behavior",
      "Policy-relevant data modeling"
    ],
    description: "Leveraging data and computational methods to understand, model, and improve urban systems and human-environment interactions.",
    projects: [
      "Disaster-Driven Population Relocation and Urban Development",
      "Planning, Buyout Policies, and Evacuation Behavior",
      "Mandatory Evacuation Policies and Hurricane Evacuation Behavior",
      "Post-Disaster Recovery Policy and Population Return Dynamics",
      "Short-Term Evacuation Behavior and Human Mobility During Flood Events",
      "Long-Term Population Migration and Spatial Reorganization After Flood Disasters",
      "Child-Centered Urban Cooling and Heat Adaptation Simulation"
    ],
    credit: "Houpu Li — Social & Environmental Data Science Lab Director",
    quote: "Urban Data Science transforms data into insights that serve communities and shape more equitable urban futures.",
    director: "Houpu Li",
    directorTitle: "Lab Director",
    image: media.houpu,
    profileHref: "https://www.geog.ucsb.edu/people/students/houpu-li",
    bio: [
      "Houpu Li is an urban data scientist specializing in GeoAI, spatial modeling, and computational urban research. He was a Research Associate at Harvard University (2024-2025).",
      "He earned a Master's degree in Regional Science from Cornell University (2022-2024) and began his Ph.D. in Geography at the University of California, Santa Barbara in Fall 2025.",
      "His work integrates GeoAI and Python-based spatial analysis to advance equitable and resilient urban development. He contributed to the study \"The Racial Composition of Road Users, Traffic Citations, and Police Stops,\" conducted under the guidance of Professor Wenfei Xu and published in PNAS (2025)."
    ],
    coDirector: "Wenzheng Li",
    coDirectorTitle: "Lab Co-Director",
    coDirectorImage: "/images/wenzheng-li.jpg",
    coDirectorProfileHref: "#",
    coDirectorBio: [
      "Wenzheng Li is a postdoctoral research fellow at the University of British Columbia and former lecturer at Cornell University.",
      "His research explores urban systems, climate adaptation, and AI-driven approaches in urban research. His recent work uses AI to shape the public engagement in housing approval process in North America.",
      "He received his Ph.D. in City and Regional Planning from Cornell University."
    ]
  },
  {
    title: "Intelligent Agents & Systems Lab",
    bullets: [
      "Agent-based systems and AI-driven workflows",
      "Human-centered and deployable AI solutions",
      "Applied machine learning for social and environmental challenges"
    ],
    description: "Developing and deploying AI and agent-based systems to support real-world applications in urban, environmental, and societal contexts.",
    projects: [
      "Intelligent Food Ingredient Analysis Platform",
      "Global Food Safety Standards Database",
      "Parenting Assistant",
      "UrbanKit — A web-based toolkit for fast, data-driven urban analysis."
    ],
    credit: "Zefan Wang — AI & Agent Systems Lab Director",
    quote: "AI agents transform data into adaptive intelligence, enabling intelligent decision-making across systems, applications, and everyday user experiences.",
    director: "Zefan Wang",
    directorTitle: "Lab Director",
    image: media.zefan,
    profileHref: "https://www.geog.ucsb.edu/people/students/houpu-li",
    bio: [
      "Zefan Wang is a Full Stack Engineer specializing in AI systems and agent-based architectures. With over 6 years of experience, he focuses on developing intelligent agents and AI-driven systems that automate complex workflows and enable adaptive, data-driven decision-making.",
      "His work explores the integration of large language models, agent frameworks, and scalable system design to build next-generation AI applications. He has contributed to large-scale deployments where intelligent systems support real-time analysis and coordinated decision processes.",
      "At SENSE Institute, he leads the development of AI agent systems that bridge research and application, pushing forward the role of autonomous and semi-autonomous systems in addressing complex challenges."
    ],
    coDirector: "Shiyun Wen",
    coDirectorTitle: "Lab Co-Director",
    coDirectorImage: "/images/shiyun_wen.jpg",
    coDirectorProfileHref: "#",
    coDirectorBio: [
      "Shiyun Wen previously worked as a software developer at Unity China and several leading game studios.",
      "With a background in Computer Science and Data Engineering, she has experience in machine learning, digital twin systems, XR technologies, and data-driven spatial applications.",
      "She brings strong engineering expertise to interdisciplinary technology and urban innovation projects."
    ]
  },
  // {
  //   title: "Theory & Foundations Lab",
  //   bullets: [
  //     "Theoretical and conceptual frameworks",
  //     "Foundations of data-driven and computational research",
  //     "Interdisciplinary research methodologies",
  //     "Ethics and critical perspectives in technology"
  //   ],
  //   description: "Advancing theoretical and methodological foundations for data-driven research in urban and environmental systems, climate resilience, and social equity.",
  //   projects: ["xxxx"],
  //   credit: "XXXXX - Theory & Foundations Lab",
  //   quote: "Urban Data Science transforms data into insights that serve communities and shape more equitable urban futures.",
  //   director: "XXX",
  //   directorTitle: "Lab Director",
  //   image: media.theory,
  //   profileHref: "https://www.geog.ucsb.edu/people/students/houpu-li",
  //   bio: [
  //     "Houpu Li is an urban data scientist specializing in GeoAI, spatial modeling, and computational urban research. He earned a Master's in Regional Science from Cornell University (2022-2024), worked as a Research Associate at Harvard (2024-2025), and began a Ph.D. in Geography at UC Santa Barbara in Fall 2025. His work integrates GeoAI and Python-based spatial analysis to advance equitable and resilient urban development."
  //   ]
  // }
];
---

<BaseLayout title="Labs" headerMode="overlay">
  <Hero
    title="Our Labs"
    video={media.labsVideo}
    poster={media.labsPoster}
    variant="labs"
    subtitle="Our labs are led by passionate young researchers and practitioners from diverse backgrounds. Together, they advance interdisciplinary research across data science, AI, and complex systems to address pressing challenges in climate, urban environments, and public well-being."
  />

  {labs.map((lab) => (
    <section class="section lab-section">
      <div class="lab-copy">
        <h2>{lab.title}</h2>
        <p class="focus">{lab.description}</p>
        <ul>
          {lab.bullets.map((item) => <li>{item}</li>)}
        </ul>
        <p><strong>Ongoing Projects:</strong></p>
        <div class="project-list">
          {lab.projects.map((project, index) => <p>Project {index + 1}: {project}</p>)}
        </div>
        <blockquote class="quote reveal-on-scroll" data-reveal>
          <p>{lab.quote}</p>
        </blockquote>
        <p class="director-credit">{lab.credit}</p>
      </div>

      <div class="directors-container">
        <article class="director-card">
          <img src={lab.image} alt={`${lab.director} portrait`} />
          
          <div>
            <h3>{lab.directorTitle} I {lab.director}</h3>
            <a class="button" href={lab.profileHref} target="_blank" rel="noreferrer">Profile</a>
          </div>
        </article>

        {lab.coDirector && (
          <article class="director-card">
            <img src={lab.coDirectorImage} alt={`${lab.coDirector} portrait`} />
            
            <div>
              <h3>{lab.coDirectorTitle} I {lab.coDirector}</h3>
              <a class="button" href={lab.coDirectorProfileHref} target="_blank" rel="noreferrer">Profile</a>
            </div>
          </article>
        )}
      </div>

      <div class="shape-divider" aria-hidden="true">
        <span class="shape-divider-layer shape-divider-layer--back"></span>
        <span class="shape-divider-layer shape-divider-layer--middle"></span>
        <span class="shape-divider-layer shape-divider-layer--front"></span>
      </div>
    </section>
  ))}
</BaseLayout>
