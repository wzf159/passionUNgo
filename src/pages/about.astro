---

<BaseLayout title="About" headerMode="overlay">
  <Hero
    title="Our Mission"
    video={media.missionVideo}
    poster={media.missionPoster}
    variant="mission"
  >
    <div class="mission-copy">
      <p>SENSE Institute is a registered 501(c)(3) nonprofit research organization led by an international network of young scholars, researchers, and practitioners. We advance problem-driven innovation for public impact through evidence-based research, public engagement programs, and open-source technology development.</p>
      <p>Grounded in four interconnected pillars&mdash;Justice, Sustainability, Resilience, and Well-being&mdash;our mission is to bridge research, technology, and public needs by integrating theoretical insight with data-driven methodologies to address real-world social and environmental challenges.</p>
    </div>

    <div class="pillar-grid pillar-grid--hero">
      {pillars.map(([title, text]) => (
        <div class="pillar">
          <strong>{title}</strong>
          <span>{text}</span>
        </div>
      ))}
    </div>
  </Hero>

  <section class="about-section about-section--advisors">

    <div class="advisors-sub-section">
      <div class="section-heading about-section-heading">
        <h2>Research Advisors</h2>
        <p class="about-note">(Names listed in alphabetical order)</p>
      </div>
      <div class="advisors-grid">
        {advisors.filter(a => a.title === "Research Advisor").map((advisor, index) => (
          <article class="advisor-card">
            <div class="advisor-front">
              <div class="advisor-img-wrap">
                <img src={advisor.image} alt={`${advisor.name} portrait`} />
              </div>
              <div class="advisor-text-section">
                <h3>{advisor.name}</h3>
                <p class="advisor-description" set:html={advisor.description} />
                <p class="advisor-affiliation">{advisor.affiliation}</p>
                <button class="advisor-toggle">Read More →</button>
              </div>
            </div>
            <div class="advisor-back">
              <div class="advisor-bio">
                <p set:html={advisor.bio} />
              </div>
              <button class="advisor-toggle advisor-toggle--back">← Back</button>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="advisors-sub-section">
      <div class="section-heading about-section-heading">
        <h2>Program Advisors</h2>
        <p class="about-note">(Names listed in alphabetical order)</p>
      </div>
      <div class="advisors-grid">
        {advisors.filter(a => a.title === "Program Advisor").map((advisor, index) => (
          <article class="advisor-card">
            <div class="advisor-front">
              <div class="advisor-img-wrap">
                <img src={advisor.image} alt={`${advisor.name} portrait`} />
              </div>
              <div class="advisor-text-section">
                <h3>{advisor.name}</h3>
                <p class="advisor-description" set:html={advisor.description} />
                <p class="advisor-affiliation">{advisor.affiliation}</p>
                <button class="advisor-toggle">Read More →</button>
              </div>
            </div>
            <div class="advisor-back">
              <div class="advisor-bio">
                <p set:html={advisor.bio} />
              </div>
              <button class="advisor-toggle advisor-toggle--back">← Back</button>
            </div>
          </article>
        ))}
      </div>
    </div>

  </section>

  <section class="about-section about-section--leadership">
    <div class="section-heading about-section-heading">
      <h2>Leadership & Administration</h2>
    </div>

    <div class="research-grid">
      {leadership.map((person, index) => (
        <article key={index} class="research-card">
          <img src={person.image} alt={`${person.name} portrait`} />
          <h3>{person.name}</h3>
          <p class="research-role">{person.role}</p>
        </article>
      ))}
    </div>
  </section>



  <section class="about-section about-section--research">
    <div class="section-heading about-section-heading">
      <h2>Research & Technology Team</h2>
    </div>

    <div class="research-grid">
      {researchTeam.map((person, index) => (
        <article key={index} class="research-card">
          <img src={person.image} alt={`${person.name} portrait`} />
          <h3>{person.name}</h3>
          <p class="research-role">{person.role}</p>
          {person.bio && <p class="research-bio">{person.bio}</p>}
        </article>
      ))}
    </div>
  </section>

    <section class="about-section about-section--ai-intelligence-lab">
    <div class="section-heading about-section-heading">
      <h2>AI & Intelligence Lab</h2>
    </div>

    <div class="research-grid">
      {aiIntelligenceLabTeam.map((person, index) => (
        <article key={index} class="research-card">
          <img src={person.image} alt={`${person.name} portrait`} />
          <h3>{person.name}</h3>
          <p class="research-role">{person.role}</p>
          {person.bio && <p class="research-bio">{person.bio}</p>}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll('.advisor-card').forEach(card => {
    card.querySelectorAll('.advisor-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        card.classList.toggle('is-flipped');
      });
    });
  });
</script>
