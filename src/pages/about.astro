---

<BaseLayout title="About" headerMode="overlay">
  <Hero
    title="Our Mission"
    video={media.missionVideo}
    poster={media.missionPoster}
    variant="mission"
  >
    <div class="mission-copy">
      <p>SENSE Institute is a registered 501(c)(3) nonprofit research organization led by young scholars and practitioners. We advance problem-driven innovation for social impact through evidence-based research, programs, and open collaboration.</p>
      <p>Our mission is grounded in four interconnected pillars: Justice, Sustainability, Resilience, and Well-being&mdash;guiding our work to integrate theoretical foundations with data-driven methodologies to address real-world challenges.</p>
    </div>
  </Hero>

  <section class="about-section about-section--advisors">
    <div class="section-heading about-section-heading">
      <h2>Research & Program Advisors</h2>
      <p class="about-note">(Names listed in alphabetical order)</p>
    </div>

    <div class="advisors-grid">
      {advisors.map((advisor, index) => (
        <article key={index} class="advisor-card">
          <img src={advisor.image} alt={`${advisor.name} portrait`} />
          <div class="advisor-content">
            <div class="advisor-text">
              <h3>{advisor.name}</h3>
              <p class="advisor-title">{advisor.title}</p>
              <p class="advisor-description">{advisor.description}</p>
              <p class="advisor-affiliation">{advisor.affiliation}</p>
            </div>
            <button class="profile-button">Profile</button>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="about-section about-section--leadership">
    <div class="section-heading about-section-heading">
      <h2>Leadership & Operations</h2>
    </div>

    <div class="leadership-grid">
      {leadership.map((person, index) => (
        <article key={index} class="leadership-card">
          <img src={person.image} alt={`${person.name} portrait`} />
          <h3>{person.name}</h3>
          <p>{person.role}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="about-section about-section--research">
    <div class="section-heading about-section-heading">
      <h2>Research & Technology Team</h2>
    </div>

    <div class="research-grid">
      {researchTeam.map((person, index) => (
        <article key={index} class="research-card">
          <img src={person.image} alt={`${person.name} portrait`} />
          <h3>{person.name}</h3>
          <p class="research-role">{person.role}</p>
          {person.bio && <p class="research-bio">{person.bio}</p>}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
