---
import Hero from "@/components/Hero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { insights, media } from "@/data/site";
---

<BaseLayout title="Insights" headerMode="overlay">
  <Hero
    title="Our Insights"
    image={media.insightsPoster}
    variant="insights"
  >
    <p class="hero-subtitle">
      We share evidence-based insights that help people better understand complex social and environmental challenges.<br /><br />
      Drawing on interdisciplinary research, data, and real-world observations, we translate scientific knowledge into clear, accessible perspectives for researchers, practitioners, policymakers, and communities.
    </p>
  </Hero>

  {insights.map((item, index) => (
    <article class="insight">
      <div class="insight-inner">
        <h2>{item.title}</h2>
        <p class="meta">{item.subtitle}</p>
        <p class="insight-contributors">{item.contributors}</p>
        <a class="button insight-button" href={item.surveyUrl} target="_blank" rel="noopener">Join the Survey</a>
        <p class="insight-text">{item.text}</p>
        <div class="insight-image insight-image--wide">
          <iframe
            src={item.embedUrl}
            title={item.title}
            style={`width:100%; height:${index === 0 ? 790 : 700}px; border:none; border-radius:12px;`}
          />
        </div>
      </div>
    </article>
  ))}
</BaseLayout>
