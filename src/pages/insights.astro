---
import Hero from "@/components/Hero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { insights, media } from "@/data/site";
---

<BaseLayout title="Insights" headerMode="overlay">
  <Hero
    title="Our Insights"
    video={media.missionVideo}
    poster={media.missionPoster}
    variant="insights"
  >
    <p class="hero-subtitle">
      We translate public perception, emerging trends, and AI-enabled inquiry into original insights on social and environmental challenges.<br />
      Our perspectives are grounded in observation, data, and a commitment to making complex issues more accessible.
    </p>
  </Hero>

  {insights.map((item, index) => (
    <article class="insight">
      <div class="insight-inner">
        <h2>{item.title}</h2>
        <p class="meta">{item.subtitle}</p>
        <p class="insight-contributors">{item.contributors}</p>
        <a class="button insight-button" href={item.surveyUrl} target="_blank" rel="noopener">Join the Survey</a>
        <p class="insight-text">{item.text}</p>
        <div class="insight-image insight-image--wide">
          <iframe
            src={item.embedUrl}
            title={item.title}
            style={`width:100%; height:${index === 0 ? 790 : 700}px; border:none; border-radius:12px;`}
          />
        </div>
      </div>
    </article>
  ))}
</BaseLayout>
