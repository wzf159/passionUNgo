---
interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
  video?: string;
  image?: string;
  poster?: string;
  ctaLabel?: string;
  ctaHref?: string;
  compact?: boolean;
  variant?: "default" | "home" | "mission" | "labs" | "insights" | "programs";
}

const { title, eyebrow, subtitle, video, image, poster, ctaLabel, ctaHref, compact = false, variant = "default" } = Astro.props;
---

<section class:list={["hero", `hero--${variant}`, { "hero--compact": compact, "hero--plain": !video && !image }]}>
  {
    video ? (
      <video class="hero-media" src={video} poster={poster} autoplay muted loop playsinline preload="metadata" />
    ) : image ? (
      <img class="hero-media" src={image} alt="" />
    ) : null
  }
  <div class="hero-overlay"></div>
  <div class="hero-content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {ctaLabel && ctaHref && <a class="button button--hero" href={ctaHref}>{ctaLabel}</a>}
    <slot />
  </div>
</section>
